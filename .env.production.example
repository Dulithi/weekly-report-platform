# Public DNS names. Create A/AAAA records before starting Caddy.
FRONTEND_DOMAIN=reports.example.com
API_DOMAIN=api.reports.example.com

# PostgreSQL. Use a generated password and do not expose the database port.
POSTGRES_DB=weekly_report
POSTGRES_USER=weekly_report_app
POSTGRES_PASSWORD=replace_with_a_generated_database_password

# Generate with: openssl rand -base64 32
JWT_SECRET_BASE64=replace_with_a_generated_256_bit_secret
REPORTING_TIME_ZONE=Asia/Colombo

# Enable only for the first start of a completely empty database, then disable.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_12_to_128_character_password
BOOTSTRAP_ADMIN_FIRST_NAME=First
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# Optional SMTP invitation delivery.
INVITATION_EMAIL_ENABLED=false
INVITATION_EMAIL_FROM=reports@example.com
INVITATION_EMAIL_APP_NAME="Weekly Report Platform"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=reports@example.com
SMTP_PASSWORD=replace_with_an_smtp_secret
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true

# Optional AI assistant. Keep disabled until a provider key and usage budget exist.
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
