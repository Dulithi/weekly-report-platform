# PostgreSQL
POSTGRES_DB=weekly_report
POSTGRES_USER=weekly_report_app
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

# Backend
DATABASE_URL=jdbc:postgresql://localhost:5432/weekly_report
DATABASE_USERNAME=weekly_report_app
DATABASE_PASSWORD=replace_me

JWT_SECRET_BASE64=replace_with_base64_256_bit_secret

REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Strict
REFRESH_COOKIE_NAME=weekly_report_refresh

FRONTEND_URL=http://localhost:3000
REPORTING_TIME_ZONE=Asia/Colombo

# Login throttling
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW=15m
INVITATION_TTL=24h

# Optional development-only demo data. Also start the backend with the dev profile.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=
