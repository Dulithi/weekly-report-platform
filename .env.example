# PostgreSQL
POSTGRES_DB=weekly_report
POSTGRES_USER=weekly_report_app
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

# Backend
DATABASE_URL=jdbc:postgresql://localhost:5432/weekly_report
DATABASE_USERNAME=weekly_report_app
DATABASE_PASSWORD=replace_me

JWT_SECRET_BASE64=replace_with_base64_256_bit_secret

REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Strict
REFRESH_COOKIE_NAME=weekly_report_refresh

FRONTEND_URL=http://localhost:3000
REPORTING_TIME_ZONE=Asia/Colombo

# One-time first administrator for a completely empty database. Disable after
# the first successful startup; an existing active admin is safely left alone.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=

# Optional invitation email delivery. The admin UI always shows the one-time
# acceptance link as a fallback even when SMTP delivery fails.
INVITATION_EMAIL_ENABLED=false
INVITATION_EMAIL_FROM=
INVITATION_ACCEPTANCE_BASE_URL=http://localhost:3000
INVITATION_EMAIL_APP_NAME="Weekly Report Platform"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

# Manager AI assistant. Keep the key in local/deployment secrets, never frontend code.
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_CONNECT_TIMEOUT=2s
OPENAI_REQUEST_TIMEOUT=20s

# Assistant safety and cost limits
AI_MAX_QUESTION_CHARACTERS=500
AI_MAX_HISTORY_MESSAGES=6
AI_MAX_HISTORY_CHARACTERS=2000
AI_MAX_WEEKS=12
AI_MAX_REPORTS=40
AI_MAX_CONTEXT_CHARACTERS=60000
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_REQUESTS_PER_WINDOW=10
AI_REQUEST_WINDOW=1m

# Login throttling
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW=15m
INVITATION_TTL=24h

# Optional development-only demo data. Also start the backend with the dev profile.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=
